---
const { currentPath } = Astro.props;

const navItems = [
  { href: "/", label: "INICIO" },
  { href: "/#nosotros", label: "NOSOTROS" },
  { href: "/proyectos", label: "PROYECTOS" },
  { href: "/galeria", label: "GALERÍA" },
  { href: "/memorias", label: "MEMORIA" },
  { href: "/boletines", label: "BOLETINES" },
  { href: "/estudios", label: "PUBLICACIONES" },
  { href: "/#contacto", label: "CONTACTO" },
];

// Function to check if a link is active
const isActive = (href: string) => {
  // For home page
  if (currentPath === "/" && href === "/") return true;

  // For other pages
  if (currentPath !== "/" && href !== "/" && currentPath.startsWith(href)) return true;

  return false;
};
---

<header class="header">
  <nav class="navbar">
    <div class="nav-container">
      <div class="nav-brand">
        <a href="/">
          <img
            src="/idacom.png"
            alt="IDACOM - Instituto de Acción Comunitaria"
            class="logo"
          />
        </a>
      </div>

      <div class="nav-menu" id="navMenu">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class={`nav-link ${isActive(item.href) ? "active" : ""}`}
            >
              {item.label}
            </a>
          ))
        }
        <a href="/#donacion" class="nav-link btn-donate">DONACIÓN</a>
      </div>

      <div class="nav-toggle" id="navToggle">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  </nav>
</header>

<style>
  .nav-brand a {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
</style>
