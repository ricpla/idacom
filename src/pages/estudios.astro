  </section>

  <style is:global>
        /* Page Hero Styles */
        .page-hero {
            min-height: 50vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
            margin-top: 80px;
            background: linear-gradient(135deg, #E4EBFC 0%, #589BE3 32%, #002F5E 63%, #3B3A3A 100%);
        }

        .page-hero-background {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
        }

        .gradient-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, 
                rgba(228, 235, 252, 0.9) 0%, 
                rgba(88, 155, 227, 0.85) 32%, 
                rgba(0, 47, 94, 0.9) 63%, 
                rgba(59, 58, 58, 0.95) 100%);
        }

        .page-hero-content {
            position: relative;
            z-index: 1;
            text-align: center;
            color: white;
            padding: 3rem 2rem;
        }

        .page-hero-title {
            font-size: clamp(2.5rem, 5vw, 4rem);
            font-weight: 700;
            margin-bottom: 1rem;
            background: linear-gradient(135deg, #ffffff, #20CE88);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: fadeInUp 0.8s ease-out;
        }

        .page-hero-subtitle {
            font-size: clamp(1rem, 2vw, 1.5rem);
            opacity: 0.95;
            animation: fadeInUp 0.8s ease-out 0.2s both;
        }

        /* Publications Section */
        .publications {
            padding: 5rem 0;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            position: relative;
        }

        .publications::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                radial-gradient(circle at 10% 20%, rgba(32, 206, 136, 0.05) 0%, transparent 50%),
                radial-gradient(circle at 90% 80%, rgba(0, 138, 252, 0.05) 0%, transparent 50%);
            pointer-events: none;
        }

        .publications-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 3rem;
            margin-top: 3rem;
            position: relative;
            z-index: 1;
        }

        .publication-card {
            background: white;
            border-radius: var(--border-radius-lg);
            overflow: hidden;
            transition: var(--transition);
            position: relative;
        }

        .publication-card:hover {
            transform: translateY(-10px);
        }

        .publication-link {
            display: block;
            text-decoration: none;
            color: inherit;
        }

        .publication-thumbnail {
            position: relative;
            overflow: hidden;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            padding: 2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 250px;
            transition: var(--transition);
        }

        .publication-thumbnail img {
            max-width: 100%;
            height: auto;
            object-fit: contain;
            transition: var(--transition);
            filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.1));
        }

        .publication-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--primary-gradient);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: var(--transition);
        }

        .publication-card:hover .publication-overlay {
            opacity: 0.95;
        }

        .publication-card:hover .publication-thumbnail img {
            transform: scale(1.05);
        }

        .download-icon {
            width: 60px;
            height: 60px;
            color: white;
            filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.2));
        }

        .publication-title {
            padding: 1.5rem;
            font-size: 1rem;
            font-weight: 600;
            line-height: 1.4;
            text-align: center;
            color: var(--text-color);
            min-height: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .publication-card:hover .publication-title {
            color: var(--primary-color);
        }

        /* Stagger Animation */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .stagger-animation {
            opacity: 1;
            animation: fadeInUp 0.8s ease-out both;
        }

        .stagger-animation:nth-child(1) { animation-delay: 0.1s; }
        .stagger-animation:nth-child(2) { animation-delay: 0.2s; }
        .stagger-animation:nth-child(3) { animation-delay: 0.3s; }
        .stagger-animation:nth-child(4) { animation-delay: 0.4s; }
        .stagger-animation:nth-child(5) { animation-delay: 0.5s; }
        .stagger-animation:nth-child(6) { animation-delay: 0.6s; }
        .stagger-animation:nth-child(7) { animation-delay: 0.7s; }
        .stagger-animation:nth-child(8) { animation-delay: 0.8s; }
        .stagger-animation:nth-child(9) { animation-delay: 0.9s; }

        /* Responsive Design */
        @media (max-width: 1024px) {
            .publications-grid {
                grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
                gap: 2rem;
            }
        }

        @media (max-width: 768px) {
            .page-hero {
                min-height: 40vh;
                margin-top: 70px;
            }

            .publications {
                padding: 3rem 0;
            }

            .publications-grid {
                grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
                gap: 1.5rem;
            }

            .publication-thumbnail {
                padding: 1.5rem;
                min-height: 200px;
            }

            .publication-title {
                font-size: 0.9rem;
                padding: 1rem;
                min-height: 70px;
            }
        }

        @media (max-width: 480px) {
            .publications-grid {
                grid-template-columns: 1fr;
                gap: 2rem;
            }

            .publication-thumbnail {
                min-height: 280px;
            }
        }
  </style>
</Layout>