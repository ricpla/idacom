            </div>
        </div>
  </section>

  <style is:global>
        /* Page Header */
        .page-header {
            padding: 150px 0 60px;
            text-align: center;
            background: linear-gradient(135deg, rgba(32, 206, 136, 0.05) 0%, rgba(54, 217, 216, 0.05) 100%);
        }

        .page-title {
            font-size: 3.5rem;
            font-weight: 700;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 1.5rem;
            letter-spacing: 2px;
        }

        .title-divider {
            width: 120px;
            height: 4px;
            background: var(--primary-gradient);
            margin: 0 auto;
            border-radius: 2px;
        }

        /* Memories Section */
        .memories-section {
            padding: 80px 0;
            min-height: calc(100vh - 400px);
        }

        .memories-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 40px;
            margin-bottom: 60px;
            padding: 40px 0;
        }

        .memory-card {
            text-decoration: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
            padding: 25px;
            background: white;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            transition: var(--transition);
            position: relative;
            overflow: hidden;
        }

        .memory-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--primary-gradient);
            opacity: 0;
            transition: var(--transition);
            z-index: 0;
        }

        .memory-card:hover::before {
            opacity: 0.05;
        }

        .memory-card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: var(--shadow-colored);
        }

        .memory-icon {
            width: 100%;
            height: 200px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            z-index: 1;
        }

        .memory-icon img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.1));
            transition: var(--transition);
        }

        .memory-card:hover .memory-icon img {
            filter: drop-shadow(0 8px 12px rgba(32, 206, 136, 0.3));
            transform: scale(1.05);
        }

        .memory-title {
            font-size: 1rem;
            font-weight: 600;
            color: var(--text-color);
            text-align: center;
            position: relative;
            z-index: 1;
            transition: var(--transition);
        }

        .memory-card:hover .memory-title {
            color: var(--primary-color);
        }

        /* Memory Actions */
        .memory-actions {
            text-align: center;
            margin: 60px 0 80px;
        }

        .memory-actions .btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 15px 40px;
            font-size: 1rem;
        }

        .btn-icon {
            width: 20px;
            height: 20px;
        }

        /* Logo Section */
        .memories-logo {
            text-align: center;
            margin-top: 80px;
            padding: 60px 0;
            opacity: 0.8;
        }

        .logo-large {
            max-width: 400px;
            width: 100%;
            height: auto;
            filter: drop-shadow(0 10px 30px rgba(0, 0, 0, 0.1));
            animation: float 6s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% {
                transform: translateY(0px);
            }
            50% {
                transform: translateY(-20px);
            }
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .page-header {
                padding: 120px 0 40px;
            }

            .page-title {
                font-size: 2.5rem;
            }

            .memories-grid {
                grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
                gap: 25px;
            }

            .memory-card {
                padding: 20px;
            }

            .memory-icon {
                height: 160px;
            }

            .memory-title {
                font-size: 0.9rem;
            }

            .memory-actions .btn {
                padding: 12px 30px;
                font-size: 0.9rem;
            }

            .logo-large {
                max-width: 300px;
            }
        }

        @media (max-width: 480px) {
            .page-title {
                font-size: 2rem;
            }

            .memories-grid {
                grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
                gap: 20px;
            }

            .memory-card {
                padding: 15px;
            }

            .memory-icon {
                height: 140px;
            }

            .memory-title {
                font-size: 0.85rem;
            }

            .logo-large {
                max-width: 250px;
            }
        }
  </style>
</Layout>