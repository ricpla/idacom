---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Violencia contra las mujeres en República Dominicana - IDACOM"
  description="En República Dominicana, la violencia de género, incluyendo el feminicidio y la violencia intrafamiliar, es un problema grave. Por: Yohanna Guzmán"
>
  <!-- Article Header -->
  <article class="blog-post">
    <div class="post-container">
      <!-- Post Header -->
      <header class="post-header">
        <h1 class="post-title">
          Violencia contra las mujeres en República Dominicana. Por: Yohanna
          Guzmán
        </h1>

        <!-- Post Meta -->
        <div class="post-meta">
          <div class="author-info">
            <div class="author-avatar">
              <svg width="32" height="32" viewBox="0 0 1000 1000">
                <circle cx="500" cy="500" r="500" fill="#cccccc"></circle>
