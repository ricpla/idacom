  <style>
    .blog-post {
      background: var(--gray-color);
      padding: 6rem 0;
      margin-top: 80px;
      min-height: calc(100vh - 80px);
    }

    .post-container {
      max-width: 740px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* Header Styles */
    .post-header {
      margin-bottom: 3rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid #e0e0e0;
    }

    .post-title {
      font-size: 2.5rem;
      font-weight: 700;
      line-height: 1.3;
      margin-bottom: 2rem;
      color: var(--dark-color);
    }

    .post-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .author-info {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .author-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      overflow: hidden;
    }

    .author-avatar svg {
      width: 100%;
      height: 100%;
    }

    .author-details {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .author-name {
      font-weight: 500;
      color: var(--dark-color);
    }

    .post-date-info {
      font-size: 0.875rem;
      color: #666;
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }

    .separator {
      color: #ddd;
    }

    .more-button {
      background: none;
      border: none;
      cursor: pointer;
      padding: 0.5rem;
      transition: var(--transition);
      color: #666;
    }

    .more-button:hover {
      color: var(--primary-color);
    }

    /* Content Styles */
    .post-content {
      background: white;
      padding: 3rem;
      border-radius: var(--border-radius-lg);
      margin-bottom: 2rem;
      box-shadow: var(--shadow);
    }

    .lead-paragraph {
      font-size: 1.25rem;
      font-weight: 400;
      line-height: 1.6;
      margin-bottom: 2rem;
      color: var(--text-color);
    }

    /* Video Styles */
    .video-container {
      margin: 2rem 0;
    }

    .video-wrapper {
      position: relative;
      padding-bottom: 56.25%; /* 16:9 aspect ratio */
      height: 0;
      overflow: hidden;
      border-radius: var(--border-radius);
      background: #000;
    }

    .youtube-video {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: none;
    }

    /* Footer Styles */
    .post-footer {
      background: white;
      padding: 2rem 3rem;
      border-radius: var(--border-radius-lg);
      margin-bottom: 2rem;
      box-shadow: var(--shadow);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .social-share {
      display: flex;
      gap: 1rem;
    }

    .share-btn {
      background: none;
      border: none;
      cursor: pointer;
      padding: 0.5rem;
      transition: var(--transition);
      color: #666;
      border-radius: var(--border-radius);
    }

    .share-btn:hover {
      background: var(--gray-color);
      color: var(--primary-color);
    }

    .share-btn svg {
      fill: currentColor;
    }

    .post-stats {
      display: flex;
      gap: 1.5rem;
      align-items: center;
    }

    .stat-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: #666;
      font-size: 0.9rem;
    }

    .stat-item svg {
      fill: currentColor;
    }

    .like-btn {
      background: none;
      border: none;
      cursor: pointer;
      padding: 0.5rem;
      transition: var(--transition);
      color: #666;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .like-btn:hover {
      color: var(--primary-color);
    }

    .like-btn.liked {
      color: var(--primary-color);
    }

    .like-btn svg {
      fill: currentColor;
    }

    .like-count {
      font-size: 0.9rem;
      font-weight: 500;
    }

    /* Back Button */
    .back-to-news {
      text-align: center;
    }

    .back-to-news .btn {
      display: inline-block;
      padding: 1rem 2rem;
      background: var(--primary-gradient);
      color: white;
      text-decoration: none;
      border-radius: var(--border-radius);
      font-weight: 600;
      transition: var(--transition);
      box-shadow: var(--shadow);
    }

    .back-to-news .btn:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-lg);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .post-title {
        font-size: 2rem;
      }

      .post-content {
        padding: 2rem 1.5rem;
      }

      .post-footer {
        flex-direction: column;
        gap: 1.5rem;
        padding: 1.5rem;
      }

      .post-meta {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
      }

      .lead-paragraph {
        font-size: 1.1rem;
      }
    }
  </style>
</Layout>
