    date: "3 abr",
    readTime: "1 Min. de lectura",
    views: "12 visualizaciones",
    comments: "0 comentarios",
    likes: 2,
    author: "idacom1983",
    video: "https://video.wixstatic.com/video/ea7cef_87f6dd388bde4c258d71fb7f7b56236e/1080p/mp4/file.mp4",
    thumbnail: "https://static.wixstatic.com/media/ea7cef_87f6dd388bde4c258d71fb7f7b56236ef000.jpg/v1/fill/w_454,h_341,fp_0.50_0.50,q_90,enc_avif,quality_auto/ea7cef_87f6dd388bde4c258d71fb7f7b56236ef000.webp",
    url: "/news/detengamos-violencia-genero",
  },
